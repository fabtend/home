{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.fab0.dev/envelope.v3.json",
  "type": "object",
  "properties": {
    "fab0": {
      "type": "number",
      "const": 3
    },
    "run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "pipeline": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "description": "the pinned version: its document's SHA-256"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "parent": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "pipeline",
        "version",
        "subject",
        "parent",
        "depth"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "visit": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "entered": {
          "type": "object",
          "properties": {
            "signal": {
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/Json"
            }
          },
          "required": [
            "signal",
            "payload"
          ],
          "additionalProperties": false,
          "description": "the signal that entered the state, and its payload: why the step runs (H.2)"
        }
      },
      "required": [
        "name",
        "visit",
        "entered"
      ],
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "n": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "of": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "the attempts the state allows: its retries and one"
        },
        "deadline": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "description": "an ISO 8601 time in UTC"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "n",
        "of",
        "deadline"
      ],
      "additionalProperties": false
    },
    "with": {
      "description": "the state's `with`",
      "$ref": "#/$defs/Json"
    },
    "data": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/Json"
      },
      "description": "earlier steps' outputs, by state (E.9)"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "anyOf": [
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Json"
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "the JSON Schema `complete`'s outputs must satisfy"
    },
    "children": {
      "type": "object",
      "properties": {
        "allowed": {
          "type": "boolean",
          "description": "whether this step may start a child now: its state has `children`, within depth and the cap"
        },
        "pipeline": {
          "description": "the one pipeline its children may run, or null for any",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "left": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "the children the run may still start (`limits.children`)"
        },
        "started": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
          },
          "description": "the children this visit has started"
        }
      },
      "required": [
        "allowed",
        "pipeline",
        "left",
        "started"
      ],
      "additionalProperties": false
    },
    "api": {
      "type": "string",
      "minLength": 1,
      "description": "https://<host>/api/v1"
    }
  },
  "required": [
    "fab0",
    "run",
    "state",
    "attempt",
    "with",
    "data",
    "links",
    "outputs",
    "children",
    "api"
  ],
  "additionalProperties": false,
  "title": "fab0 envelope",
  "description": "What a step's executor reads with its step id (I.4)",
  "$defs": {
    "Json": {
      "$ref": "#/$defs/__schema0"
    },
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
